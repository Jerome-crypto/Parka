# Server
DATABASE_URL=postgresql://postgres:admin@localhost:5432/parka
NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=parka_jwt_super_secret_key_2024_change_in_production
JWT_REFRESH_SECRET=parka_refresh_super_secret_key_2024_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client origin
CLIENT_URL=http://localhost:5173

# DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=parka

# Email Gateway (Gmail SMTP / Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
